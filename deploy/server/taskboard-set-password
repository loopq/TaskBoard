#!/usr/bin/env bash
set +x
set -euo pipefail
umask 077
[[ $EUID == 0 && -t 0 && -t 1 ]] || { echo '请在自己的终端以 sudo 运行（需要 TTY）' >&2; exit 1; }
case "${1:-}" in
  zhuhu) key=PW_ZHUHU ;;
  lvcui) key=PW_LVCUI ;;
  *) echo '用法：taskboard-set-password zhuhu|lvcui' >&2; exit 1 ;;
esac
IFS= read -rs -p "输入 $1 的新密码（至少 6 位）：" password
printf '\n'
IFS= read -rs -p '再次输入：' confirm
printf '\n'
[[ $password == "$confirm" ]] || { echo '两次输入不一致' >&2; exit 1; }
[[ ${#password} -ge 6 && $password != *"'"* && $password != *$'\n'* && $password != *$'\r'* ]] || {
  echo '密码至少 6 位，不能包含单引号或换行' >&2; exit 1;
}
unset confirm
exec 8>/run/lock/taskboard-deploy.lock
flock -w 120 8
secrets=/etc/taskboard/secrets.env
[[ -f $secrets ]] || { echo '请先部署应用' >&2; exit 1; }
temp=$(mktemp /etc/taskboard/.secrets.XXXXXX)
previous=$(mktemp /etc/taskboard/.secrets.previous.XXXXXX)
trap 'rm -f -- "$temp" "$previous"; unset password' EXIT
cp -p "$secrets" "$previous"
found=0
# 密码只由 read/printf/变量展开处理，不传给任何外部进程的 argv。
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line == "$key="* ]]; then
    printf "%s='%s'\n" "$key" "$password"
    found=$((found + 1))
  else
    printf '%s\n' "$line"
  fi
done <"$secrets" >"$temp"
[[ $found == 1 ]] || { echo '密钥文件格式异常，未修改' >&2; exit 1; }
unset password line
chmod 0600 "$temp"
mv -f "$temp" "$secrets"
compose=(docker compose --env-file /etc/taskboard/release.env -f /etc/taskboard/compose.yaml)
if ! "${compose[@]}" up -d --force-recreate --wait --wait-timeout 90; then
  mv -f "$previous" "$secrets"
  "${compose[@]}" up -d --force-recreate --wait --wait-timeout 90
  echo '启动失败，密码已回滚' >&2
  exit 1
fi
printf '%s 的密码已更新。\n' "$1"
